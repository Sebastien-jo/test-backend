# Copy this file to `.env` before starting the stack (`make up` does it for you).
# docker-compose reads `.env` automatically for both variable interpolation and
# the services' env_file.

POSTGRES_USER=primmo
POSTGRES_PASSWORD=primmo
POSTGRES_DB=primmo
DATABASE_URL=postgresql+asyncpg://primmo:primmo@db:5432/primmo
REDIS_URL=redis://redis:6379/0
JWT_SECRET=dev-insecure-change-me
PARTNER_HMAC_SECRET=dev-insecure-change-me
