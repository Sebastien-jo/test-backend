# Copy this file to `.env` before starting the stack (`make up` does it for you).
# docker-compose reads `.env` automatically for both variable interpolation and
# the services' env_file.

POSTGRES_USER=primmo
POSTGRES_PASSWORD=primmo
POSTGRES_DB=primmo
DATABASE_URL=postgresql+asyncpg://primmo:primmo@db:5432/primmo
REDIS_URL=redis://redis:6379/0
# Use >= 32-byte random secrets in real environments (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-insecure-jwt-secret-change-me-please
PARTNER_HMAC_SECRET=dev-insecure-partner-hmac-change-me
STORAGE_BACKEND=local
STORAGE_PATH=/data/uploads
MAX_UPLOAD_BYTES=20971520
